{
  "name": "oppo-bac-ninh-20-10",
  "version": "1.0.0",
  "private": true,
  "description": "Video chúc mừng 20/10 cho OPPO Bắc Ninh — Remotion 2K",
  "scripts": {
    "start": "remotion studio src/index.ts --no-open",
    "studio": "remotion studio src/index.ts --no-open",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check": "npm run typecheck && npm run lint",
    "build": "remotion bundle src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "render": "python3 scripts/final/render_minimal.py",
    "media:prepare": "python3 scripts/final/prepare.py && python3 scripts/final/audio_sync.py",
    "prerender": "npm run media:prepare && npm run check && npm run preview:final",
    "verify:render": "python3 scripts/final/verify.py",
    "render:fast": "npm run media:prepare && npm run check && npm run preview:final && python3 scripts/final/render_minimal.py",
    "media:stage": "python3 scripts/final/render.py stages",
    "preview:final": "python3 scripts/final/preview.py",
    "preflight": "python3 scripts/final/preflight.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/media": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
