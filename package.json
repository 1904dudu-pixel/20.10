{
  "name": "oppo-bac-ninh-20-10",
  "version": "1.0.0",
  "private": true,
  "description": "Video chúc mừng 20/10 cho OPPO Bắc Ninh — Remotion 2K",
  "scripts": {
    "start": "remotion studio src/index.ts --no-open",
    "studio": "remotion studio src/index.ts --no-open",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check": "npm run typecheck && npm run lint",
    "build": "remotion bundle src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts OppoBacNinh2010 out/oppo-bac-ninh-20-10-1440p60.mp4 --codec=h264 --pixel-format=yuv420p --crf=16 --x264-preset=slow --audio-codec=aac --audio-bitrate=320k --image-format=png",
    "media:prepare": "node scripts/prepare-media.mjs",
    "prerender": "npm run media:prepare && npm run check",
    "verify:render": "node scripts/verify-render.mjs",
    "render:fast": "npm run media:prepare && npm run check && node scripts/render-native.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/media": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
